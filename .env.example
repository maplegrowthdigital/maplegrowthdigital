# ==========================================================================
# MapleGrowth Digital — environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.
# ==========================================================================

# --------------------------------------------------------------------------
# Resend — newsletter (audiences) + wizard submissions (transactional email)
# https://resend.com/api-keys
# --------------------------------------------------------------------------
# Server-only. Grant scopes: "Sending access" + "Audiences full access".
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Audience ID for the "MapleGrowth Newsletter" audience.
# Create at https://resend.com/audiences then copy the ID.
RESEND_AUDIENCE_ID=00000000-0000-0000-0000-000000000000

# From-address for all transactional emails. Must be a verified domain in
# Resend. Use no-reply@ to keep replies routed to a real human inbox.
RESEND_FROM="MapleGrowth Digital <no-reply@maplegrowthdigital.ca>"

# Where wizard submissions get delivered.
WIZARD_TO_EMAIL=info@maplegrowthdigital.ca

# --------------------------------------------------------------------------
# Upstash Redis — rate limiting on /api/tidycal/bookings, /api/newsletter,
# /api/configure.
#
# Two naming conventions are accepted (whichever you have set works):
#
#   1. Direct Upstash dashboard:
#        UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN
#
#   2. Vercel Marketplace integration (auto-injected when you connect
#      Upstash via Vercel; uses the legacy KV-style names because Vercel
#      KV was Upstash under the hood):
#        KV_REST_API_URL + KV_REST_API_TOKEN
#
# For local dev: paste whichever pair from the Upstash dashboard.
# For Vercel: nothing to do — the integration injects the KV_* vars.
# --------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# OR (Vercel Marketplace auto-injected — leave the above blank):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --------------------------------------------------------------------------
# Cloudflare Turnstile — invisible CAPTCHA on Newsletter + Wizard forms.
# https://dash.cloudflare.com → Turnstile → Add Site
# --------------------------------------------------------------------------
# Public (sent to client JS). Site key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Private (server-only). Secret key for token verification.
TURNSTILE_SECRET_KEY=

# --------------------------------------------------------------------------
# TidyCal — booking widget API integration (SERVER ONLY, never expose).
# Create a Personal Access Token at https://tidycal.com/integrations/oauth
# If unset, /api/tidycal/* routes fall back to mock data.
# --------------------------------------------------------------------------
TIDYCAL_TOKEN=
# Optional override (defaults to https://tidycal.com/api):
# TIDYCAL_BASE_URL=https://tidycal.com/api

# --------------------------------------------------------------------------
# Analytics — Vercel Analytics is enabled in the Vercel dashboard (no key
# needed). GTM / GA below are optional layers on top.
# --------------------------------------------------------------------------
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
